; Open with Godot 4.7.2 or later (standard build, GDScript).
config_version=5

[application]
config/name="Nobby Mana"
run/main_scene="res://scenes/clearing.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.14, 0.22, 0.20, 1)

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Hero"
2d_physics/layer_3="Enemies"
